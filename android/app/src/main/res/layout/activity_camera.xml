<?xml version="1.0" encoding="utf-8"?>
<!-- Capture flow surface: preview of the shot with an optional caption and a
     send button; the "on its way" card after send; and a visible error card so
     a failure never looks like the window simply closed. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/sand">

    <LinearLayout
        android:id="@+id/previewUi"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_margin="16dp"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:layoutDirection="rtl"
        android:background="@drawable/sent_card"
        android:padding="14dp"
        android:visibility="gone">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center_horizontal"
                android:layout_gravity="center_vertical">

                <ImageView
                    android:id="@+id/previewImage"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:adjustViewBounds="true"
                    android:maxHeight="300dp"
                    android:scaleType="fitCenter"
                    android:contentDescription="@string/photo_preview" />

                <EditText
                    android:id="@+id/captionInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:hint="@string/caption_hint"
                    android:maxLength="50"
                    android:maxLines="1"
                    android:inputType="text|textCapSentences"
                    android:imeOptions="actionDone"
                    android:importantForAutofill="no"
                    android:gravity="center"
                    android:textSize="16sp"
                    android:textColor="#3B352E"
                    android:textColorHint="#8C8377"
                    android:background="@drawable/input_box"
                    android:padding="12dp" />
            </LinearLayout>
        </ScrollView>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal"
            android:gravity="center">

            <Button
                android:id="@+id/sendBtn"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:background="@drawable/btn_primary"
                android:textColor="#F3EDE4"
                android:textAllCaps="false"
                android:textSize="15sp"
                android:minHeight="48dp"
                android:paddingStart="30dp"
                android:paddingEnd="30dp"
                android:text="@string/send_photo" />

            <Button
                android:id="@+id/cancelBtn"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:background="@android:color/transparent"
                android:textColor="#8C8377"
                android:textAllCaps="false"
                android:textSize="15sp"
                android:minHeight="48dp"
                android:paddingStart="18dp"
                android:paddingEnd="18dp"
                android:text="@string/cancel" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/sentCard"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/sent_card"
        android:paddingStart="20dp"
        android:paddingEnd="24dp"
        android:paddingTop="14dp"
        android:paddingBottom="14dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/sentCheck"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/check_mark"
            android:textSize="24sp"
            android:textColor="#C9A69A" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:text="@string/photo_on_the_way"
            android:textSize="15sp"
            android:textColor="#3B352E" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/errorCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_margin="32dp"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:layoutDirection="rtl"
        android:background="@drawable/sent_card"
        android:padding="22dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/errorText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="15sp"
            android:textColor="#A0522D"
            android:gravity="center"
            android:lineSpacingMultiplier="1.4" />

        <Button
            android:id="@+id/closeBtn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/btn_primary"
            android:textColor="#F3EDE4"
            android:textAllCaps="false"
            android:textSize="15sp"
            android:minHeight="48dp"
            android:paddingStart="30dp"
            android:paddingEnd="30dp"
            android:text="@string/close" />
    </LinearLayout>
</FrameLayout>
