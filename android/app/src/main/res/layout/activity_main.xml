<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/mainScroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/app_bg"
    android:fillViewport="true"
    android:clipToPadding="false"
    android:scrollbarStyle="outsideOverlay">

    <LinearLayout
        android:id="@+id/mainRoot"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingTop="24dp"
        android:paddingBottom="28dp"
        android:layoutDirection="rtl">

        <TextView android:id="@+id/appTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:text="אקוטרייס" android:textSize="21sp" android:gravity="center" android:textColor="@color/app_ink" android:layout_marginBottom="12dp" />
        <TextView
            android:id="@+id/introText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/intro_text"
            android:textColor="@color/app_ink"
            android:textSize="16sp"
            android:lineSpacingMultiplier="1.4"
            android:gravity="center"
            android:textAlignment="center" />

        <TextView
            android:id="@+id/myCodeLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:text="@string/your_code"
            android:textSize="13sp"
            android:textColor="@color/app_secondary" />

        <TextView
            android:id="@+id/myCode"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:gravity="center"
            android:textDirection="ltr"
            android:textSize="34sp"
            android:autoSizeTextType="uniform"
            android:autoSizeMinTextSize="18sp"
            android:autoSizeMaxTextSize="34sp"
            android:autoSizeStepGranularity="1sp"
            android:maxLines="1"
            android:letterSpacing="0.20"
            android:textColor="@color/app_ink"
            android:textIsSelectable="true" />

        <Button android:id="@+id/copyCode" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:text="העתקת הקוד" android:textAllCaps="false" android:textColor="@color/app_ink" android:background="@drawable/app_input" />

        <TextView
            android:id="@+id/pairStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center"
            android:textAlignment="center"
            android:textSize="15sp"
            android:textColor="@color/app_ink"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/pairSection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:layout_marginTop="8dp">

            <EditText
                android:id="@+id/partnerCode"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="56dp"
                android:hint="@string/partner_code_hint"
                android:maxLength="6"
                android:maxLines="1"
                android:singleLine="true"
                android:inputType="textCapCharacters|textNoSuggestions"
                android:imeOptions="actionDone"
                android:importantForAutofill="no"
                android:gravity="center"
                android:textDirection="ltr"
                android:textSize="22sp"
                android:letterSpacing="0.16"
                android:textColor="@color/app_ink"
                android:textColorHint="@color/app_secondary"
                android:background="@drawable/app_input"
                android:paddingStart="12dp"
                android:paddingEnd="12dp" />

            <RadioGroup
                android:id="@+id/roleGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="start"
                android:layout_marginTop="8dp">
                <RadioButton android:id="@+id/roleBoth" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:gravity="center_vertical" android:text="@string/role_both" android:textColor="@color/app_ink" android:checked="true" />
                <RadioButton android:id="@+id/roleSender" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:gravity="center_vertical" android:text="@string/role_sender" android:textColor="@color/app_ink" />
                <RadioButton android:id="@+id/roleViewer" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:gravity="center_vertical" android:text="@string/role_viewer" android:textColor="@color/app_ink" />
            </RadioGroup>

            <TextView
                android:id="@+id/error"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/bad_code"
                android:textColor="#934720"
                android:textSize="13sp"
                android:gravity="center"
                android:textAlignment="center"
                android:layout_marginTop="4dp"
                android:visibility="gone" />

            <Button
                android:id="@+id/connectBtn"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/app_button"
                android:textColor="#F3EDE4"
                android:textAllCaps="false"
                android:textSize="15sp"
                android:minHeight="48dp"
                android:text="@string/connect" />
        </LinearLayout>

        <Button
            android:id="@+id/startOver"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/app_button"
            android:textColor="#F3EDE4"
            android:textAllCaps="false"
            android:textSize="15sp"
            android:minHeight="48dp"
            android:text="@string/start_over"
            android:visibility="gone" />

        <TextView
            android:id="@+id/widgetDebug"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:textSize="12sp"
            android:textColor="@color/app_secondary"
            android:gravity="center"
            android:textAlignment="center"
            android:visibility="gone" />

        <TextView
            android:id="@+id/uploadDebug"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textSize="12sp"
            android:textColor="@color/app_secondary"
            android:gravity="center"
            android:textAlignment="center"
            android:visibility="gone" />

        <TextView android:id="@+id/syncStatus" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:textSize="15sp" android:textColor="@color/app_ink" android:gravity="center" />
        <TextView android:id="@+id/receiveStatus" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:textSize="14sp" android:textColor="@color/app_secondary" android:gravity="center" />
        <TextView android:id="@+id/connectionNote" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:textSize="12sp" android:textColor="@color/app_secondary" android:gravity="center" android:lineSpacingMultiplier="1.3" />
        <Button android:id="@+id/checkNow" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:minHeight="48dp" android:text="בדיקת חיבור וקבלת תמונה" android:textAllCaps="false" android:textColor="@color/app_ink" android:background="@drawable/app_input" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="באפליקציה פתוחה: בדיקה כל 30 שניות. ברקע: Android עשוי לעכב מעבר ל־15 דקות." android:textSize="12sp" android:textColor="@color/app_secondary" android:gravity="center" />

        <Button
            android:id="@+id/addWidget"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:background="@drawable/app_button"
            android:textColor="#F3EDE4"
            android:textAllCaps="false"
            android:textSize="15sp"
            android:minHeight="48dp"
            android:text="@string/add_widget" />
    </LinearLayout>
</ScrollView>
