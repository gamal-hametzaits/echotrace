<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/mainScroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/m_bg"
    android:fillViewport="true"
    android:clipToPadding="false"
    android:scrollbarStyle="outsideOverlay">

    <LinearLayout
        android:id="@+id/mainRoot"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingTop="24dp"
        android:paddingBottom="28dp">

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginBottom="4dp">
            <Button android:id="@+id/langBtn" android:layout_width="wrap_content" android:layout_height="wrap_content" android:minHeight="48dp" android:minWidth="48dp" android:textAllCaps="false" android:textSize="13sp" android:textColor="@color/m_sec" android:background="@drawable/m_input" android:paddingStart="16dp" android:paddingEnd="16dp" android:contentDescription="@string/toggle_lang_desc" />
            <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />
            <Button android:id="@+id/themeBtn" android:layout_width="wrap_content" android:layout_height="wrap_content" android:minHeight="48dp" android:minWidth="48dp" android:textAllCaps="false" android:textSize="13sp" android:textColor="@color/m_sec" android:background="@drawable/m_input" android:paddingStart="16dp" android:paddingEnd="16dp" android:contentDescription="@string/toggle_theme_desc" />
        </LinearLayout>
        <TextView android:id="@+id/appTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:text="EchoTrace" android:letterSpacing="0.06" android:textDirection="ltr" android:textSize="26sp" android:gravity="center" android:textColor="@color/m_ink" android:layout_marginBottom="12dp" />
        <TextView
            android:id="@+id/introText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/intro_text"
            android:textColor="@color/m_ink"
            android:textSize="16sp"
            android:lineSpacingMultiplier="1.4"
            android:gravity="center"
            android:textAlignment="center" />

        <TextView
            android:id="@+id/myCodeLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:text="@string/your_code"
            android:textSize="13sp"
            android:textColor="@color/m_sec" />

        <TextView
            android:id="@+id/myCode"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:gravity="center"
            android:textDirection="ltr"
            android:textSize="34sp"
            android:autoSizeTextType="uniform"
            android:autoSizeMinTextSize="18sp"
            android:autoSizeMaxTextSize="34sp"
            android:autoSizeStepGranularity="1sp"
            android:maxLines="1"
            android:letterSpacing="0.20"
            android:textColor="@color/m_ink"
            android:textIsSelectable="true" />

        <Button android:id="@+id/copyCode" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:text="@string/copy_code" android:textAllCaps="false" android:textColor="@color/m_ink" android:background="@drawable/m_input" />

        <LinearLayout android:id="@+id/statusCard" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginTop="14dp" android:padding="14dp" android:minHeight="56dp" android:background="@drawable/m_input">
            <TextView android:id="@+id/cardDot" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="●" android:textSize="18sp" android:importantForAccessibility="no" android:layout_marginEnd="12dp" />
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                <TextView android:id="@+id/cardTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="16sp" android:textColor="@color/m_ink" />
                <TextView android:id="@+id/cardSub" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="13sp" android:textColor="@color/m_sec" android:layout_marginTop="2dp" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/pairStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center"
            android:textAlignment="center"
            android:textSize="15sp"
            android:textColor="@color/m_ink"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/pairSection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:layout_marginTop="8dp">

            <EditText
                android:id="@+id/partnerCode"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="56dp"
                android:hint="@string/partner_code_hint"
                android:maxLength="6"
                android:maxLines="1"
                android:singleLine="true"
                android:inputType="textCapCharacters|textNoSuggestions"
                android:imeOptions="actionDone"
                android:importantForAutofill="no"
                android:gravity="center"
                android:textDirection="ltr"
                android:textSize="22sp"
                android:letterSpacing="0.16"
                android:textColor="@color/m_ink"
                android:textColorHint="@color/m_sec"
                android:background="@drawable/m_input"
                android:paddingStart="12dp"
                android:paddingEnd="12dp" />

            <RadioGroup
                android:id="@+id/roleGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="start"
                android:layout_marginTop="8dp">
                <RadioButton android:id="@+id/roleBoth" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:gravity="center_vertical" android:text="@string/role_both" android:textColor="@color/m_ink" android:checked="true" />
                <RadioButton android:id="@+id/roleSender" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:gravity="center_vertical" android:text="@string/role_sender" android:textColor="@color/m_ink" />
                <RadioButton android:id="@+id/roleViewer" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:gravity="center_vertical" android:text="@string/role_viewer" android:textColor="@color/m_ink" />
            </RadioGroup>

            <TextView
                android:id="@+id/error"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/bad_code"
                android:textColor="#934720"
                android:textSize="13sp"
                android:gravity="center"
                android:textAlignment="center"
                android:layout_marginTop="4dp"
                android:visibility="gone" />

            <Button
                android:id="@+id/connectBtn"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/m_button"
                android:textColor="@color/m_btn_text"
                android:textAllCaps="false"
                android:textSize="15sp"
                android:minHeight="48dp"
                android:text="@string/connect" />
        </LinearLayout>

        <Button
            android:id="@+id/startOver"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/m_button"
            android:textColor="@color/m_btn_text"
            android:textAllCaps="false"
            android:textSize="15sp"
            android:minHeight="48dp"
            android:text="@string/start_over"
            android:visibility="gone" />

        <TextView
            android:id="@+id/widgetDebug"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:textSize="12sp"
            android:textColor="@color/m_sec"
            android:gravity="center"
            android:textAlignment="center"
            android:visibility="gone" />

        <TextView
            android:id="@+id/uploadDebug"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textSize="12sp"
            android:textColor="@color/m_sec"
            android:gravity="center"
            android:textAlignment="center"
            android:visibility="gone" />

        <TextView android:id="@+id/syncStatus" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:textSize="15sp" android:textColor="@color/m_ink" android:gravity="center" />
        <TextView android:id="@+id/receiveStatus" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:textSize="14sp" android:textColor="@color/m_sec" android:gravity="center" />
        <TextView android:id="@+id/connectionNote" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:textSize="12sp" android:textColor="@color/m_sec" android:gravity="center" android:lineSpacingMultiplier="1.3" />
        <Button android:id="@+id/checkNow" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:minHeight="48dp" android:text="@string/check_now_btn" android:textAllCaps="false" android:textColor="@color/m_ink" android:background="@drawable/m_input" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="@string/poll_note" android:textSize="12sp" android:textColor="@color/m_sec" android:gravity="center" />

        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="22dp" android:text="@string/quick_settings" android:textSize="13sp" android:textColor="@color/m_sec" android:gravity="center" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginTop="8dp" android:padding="12dp" android:background="@drawable/m_input">
            <Switch android:id="@+id/wifiSwitch" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:text="@string/set_wifi" android:textColor="@color/m_ink" android:textSize="15sp" />
            <Switch android:id="@+id/animSwitch" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:text="@string/set_anim" android:textColor="@color/m_ink" android:textSize="15sp" />
            <Switch android:id="@+id/instantSwitch" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:text="@string/set_instant" android:textColor="@color/m_ink" android:textSize="15sp" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/set_instant_note" android:textSize="12sp" android:textColor="@color/m_sec" android:lineSpacingMultiplier="1.3" />
            <Button android:id="@+id/batteryBtn" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:text="@string/battery_btn" android:textAllCaps="false" android:textColor="@color/m_ink" android:background="@null" android:gravity="start|center_vertical" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="36dp" android:gravity="center_vertical" android:text="@string/set_photo_shows" android:textSize="13sp" android:textColor="@color/m_sec" />
            <RadioGroup android:id="@+id/wallGroup" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
                <RadioButton android:id="@+id/wall0" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:text="@string/wall_widget" android:textColor="@color/m_ink" />
                <RadioButton android:id="@+id/wall1" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:text="@string/wall_home" android:textColor="@color/m_ink" />
                <RadioButton android:id="@+id/wall2" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:text="@string/wall_lock" android:textColor="@color/m_ink" />
                <RadioButton android:id="@+id/wall3" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:text="@string/wall_both" android:textColor="@color/m_ink" />
            </RadioGroup>
            <TextView android:id="@+id/wallNote" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/wall_note" android:textSize="12sp" android:textColor="@color/m_sec" android:lineSpacingMultiplier="1.3" />
            <Button android:id="@+id/restoreBtn" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:text="@string/restore_pick" android:textAllCaps="false" android:textColor="@color/m_ink" android:background="@null" android:gravity="start|center_vertical" />
            <Button android:id="@+id/restoreNow" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:text="@string/restore_now" android:textAllCaps="false" android:textColor="@color/m_ink" android:background="@null" android:gravity="start|center_vertical" />
            <TextView android:id="@+id/versionRow" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="40dp" android:gravity="center_vertical" android:textSize="12sp" android:textColor="@color/m_sec" />
        </LinearLayout>

        <Button
            android:id="@+id/addWidget"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:background="@drawable/m_button"
            android:textColor="@color/m_btn_text"
            android:textAllCaps="false"
            android:textSize="15sp"
            android:minHeight="48dp"
            android:text="@string/add_widget" />
    </LinearLayout>
</ScrollView>
