<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/mainScroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/sand"
    android:fillViewport="true"
    android:clipToPadding="false"
    android:scrollbarStyle="outsideOverlay">

    <LinearLayout
        android:id="@+id/mainRoot"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingTop="24dp"
        android:paddingBottom="28dp"
        android:layoutDirection="rtl">

        <TextView
            android:id="@+id/introText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/intro_text"
            android:textColor="@color/ink"
            android:textSize="16sp"
            android:lineSpacingMultiplier="1.4"
            android:gravity="center"
            android:textAlignment="center" />

        <TextView
            android:id="@+id/myCodeLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:text="@string/your_code"
            android:textSize="13sp"
            android:textColor="#746C62" />

        <TextView
            android:id="@+id/myCode"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:gravity="center"
            android:textDirection="ltr"
            android:textSize="34sp"
            android:letterSpacing="0.20"
            android:textColor="#3B352E"
            android:textIsSelectable="true" />

        <TextView
            android:id="@+id/pairStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center"
            android:textAlignment="center"
            android:textSize="15sp"
            android:textColor="#3B352E"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/pairSection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:layout_marginTop="8dp">

            <EditText
                android:id="@+id/partnerCode"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="56dp"
                android:hint="@string/partner_code_hint"
                android:maxLength="6"
                android:maxLines="1"
                android:singleLine="true"
                android:inputType="textCapCharacters|textNoSuggestions"
                android:imeOptions="actionDone"
                android:importantForAutofill="no"
                android:gravity="center"
                android:textDirection="ltr"
                android:textSize="22sp"
                android:letterSpacing="0.16"
                android:textColor="#3B352E"
                android:textColorHint="#746C62"
                android:background="@drawable/input_box"
                android:paddingStart="12dp"
                android:paddingEnd="12dp" />

            <RadioGroup
                android:id="@+id/roleGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="start"
                android:layout_marginTop="8dp">
                <RadioButton android:id="@+id/roleBoth" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:gravity="center_vertical" android:text="@string/role_both" android:textColor="#3B352E" android:checked="true" />
                <RadioButton android:id="@+id/roleSender" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:gravity="center_vertical" android:text="@string/role_sender" android:textColor="#3B352E" />
                <RadioButton android:id="@+id/roleViewer" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:gravity="center_vertical" android:text="@string/role_viewer" android:textColor="#3B352E" />
            </RadioGroup>

            <TextView
                android:id="@+id/error"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/bad_code"
                android:textColor="#934720"
                android:textSize="13sp"
                android:gravity="center"
                android:textAlignment="center"
                android:layout_marginTop="4dp"
                android:visibility="gone" />

            <Button
                android:id="@+id/connectBtn"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/btn_primary"
                android:textColor="#F3EDE4"
                android:textAllCaps="false"
                android:textSize="15sp"
                android:minHeight="48dp"
                android:text="@string/connect" />
        </LinearLayout>

        <Button
            android:id="@+id/startOver"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/btn_primary"
            android:textColor="#F3EDE4"
            android:textAllCaps="false"
            android:textSize="15sp"
            android:minHeight="48dp"
            android:text="@string/start_over"
            android:visibility="gone" />

        <TextView
            android:id="@+id/widgetDebug"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:textSize="12sp"
            android:textColor="#746C62"
            android:gravity="center"
            android:textAlignment="center"
            android:visibility="gone" />

        <TextView
            android:id="@+id/uploadDebug"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textSize="12sp"
            android:textColor="#746C62"
            android:gravity="center"
            android:textAlignment="center"
            android:visibility="gone" />

        <Button
            android:id="@+id/addWidget"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:background="@drawable/btn_primary"
            android:textColor="#F3EDE4"
            android:textAllCaps="false"
            android:textSize="15sp"
            android:minHeight="48dp"
            android:text="@string/add_widget" />
    </LinearLayout>
</ScrollView>
