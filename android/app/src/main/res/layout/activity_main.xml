<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/sand">

    <LinearLayout
        android:id="@+id/mainRoot"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:padding="32dp"
        android:layoutDirection="rtl">

        <TextView
            android:id="@+id/introText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/intro_text"
            android:textColor="@color/ink"
            android:textSize="16sp"
            android:lineSpacingMultiplier="1.5"
            android:gravity="center" />

        <TextView
            android:id="@+id/myCodeLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="26dp"
            android:text="@string/your_code"
            android:textSize="13sp"
            android:textColor="#8C8377" />

        <TextView
            android:id="@+id/myCode"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="34sp"
            android:letterSpacing="0.25"
            android:textColor="#3B352E"
            android:textIsSelectable="true" />

        <TextView
            android:id="@+id/pairStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:textSize="15sp"
            android:textColor="#3B352E"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/pairSection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:layout_marginTop="10dp">

            <EditText
                android:id="@+id/partnerCode"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/partner_code_hint"
                android:maxLength="6"
                android:inputType="textCapCharacters|textNoSuggestions"
                android:gravity="center"
                android:textSize="22sp"
                android:letterSpacing="0.2"
                android:background="@drawable/input_box"
                android:padding="12dp" />

            <RadioGroup
                android:id="@+id/roleGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:layout_marginTop="12dp">
                <RadioButton android:id="@+id/roleBoth" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/role_both" android:checked="true" />
                <RadioButton android:id="@+id/roleSender" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/role_sender" />
                <RadioButton android:id="@+id/roleViewer" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/role_viewer" />
            </RadioGroup>

            <TextView
                android:id="@+id/error"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/bad_code"
                android:textColor="#A0522D"
                android:textSize="13sp"
                android:layout_marginTop="6dp"
                android:visibility="gone" />

            <Button
                android:id="@+id/connectBtn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/btn_primary"
                android:textColor="#F3EDE4"
                android:textAllCaps="false"
                android:textSize="15sp"
                android:minHeight="48dp"
                android:paddingLeft="34dp"
                android:paddingRight="34dp"
                android:text="@string/connect" />
        </LinearLayout>

        <TextView
            android:id="@+id/widgetDebug"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:textSize="12sp"
            android:textColor="#8C8377"
            android:gravity="center"
            android:visibility="gone" />

        <TextView
            android:id="@+id/uploadDebug"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textSize="12sp"
            android:textColor="#8C8377"
            android:gravity="center"
            android:visibility="gone" />

        <Button
            android:id="@+id/addWidget"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:background="@drawable/btn_primary"
            android:textColor="#F3EDE4"
            android:textAllCaps="false"
            android:textSize="15sp"
            android:minHeight="48dp"
            android:paddingLeft="30dp"
            android:paddingRight="30dp"
            android:text="@string/add_widget" />
    </LinearLayout>
</ScrollView>
